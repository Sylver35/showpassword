{
    "name": "sylver35/showpassword",
    "type": "phpbb-extension",
    "description": "This extension allows you to show password in all login forms with 1 clic",
    "homepage": "https://breizhcode.com",
    "version": "1.3.0",
    "time": "2025-01-16",
    "keywords": [
        "phpbb",
        "extension",
        "password",
        "show",
        "hide",
        "login"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "sylver35",
			"email": "webmaster@breizhcode.com",
            "homepage": "https://breizhcode.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.2",
        "composer/installers": "~2.0.0",
        "phpbb/phpbb": ">=3.3.8"
    },
	 "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "display-name": "Breizh Show Password",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.8"
        },
        "version-check": {
            "host": "breizhversions.com",
            "directory": "/showpassword",
            "filename": "/version_check.json",
            "ssl": false
        }
    }
}